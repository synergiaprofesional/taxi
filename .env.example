# ==============================================================================
# CONFIGURACIÓN DE INFRAESTRUCTURA Y SECRETOS (CAPA 1) - PROYECTO TAXI
# ==============================================================================

# 1. Servidor de Producción (SOLO LECTURA / CONSULTA)
PROD_SERVER_HOST=fundetaxcol.co
PROD_SERVER_IP=149.22.88.135
PROD_SERVER_USER=root
PROD_SERVER_PASSWORD=your_password_here
PROD_SERVER_READ_ONLY=true

# 2. Configuración de Firebase (Backend Objetivo)
FIREBASE_PROJECT_ID=taxi-app-prod
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=taxi-app-prod.firebaseapp.com
FIREBASE_DATABASE_URL=https://taxi-app-prod-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=taxi-app-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# 3. Entorno de Ejecución
APP_ENV=development
APP_VERSION=3.0.0
APP_BUILD_NUMBER=1
DEBUG_MODE=true
