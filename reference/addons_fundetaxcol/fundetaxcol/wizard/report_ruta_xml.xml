<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_ruta_view" model="ir.ui.view">
        <field name="name">Filtro rango de fechas</field>
        <field name="model">wizard.report.turno</field>
        <field name="arch" type="xml">
            <form>
            	<sheet>
                    <group>
                		<group>
    		            	<field name="periodo"/>
                            <field name="tarifa_id" options="{'no_quick_create':True,'no_create_edit':True}"/>
                            <!--field name="orden"/-->
                            <field name="imprimir_sumario"/>
    		            </group>
                        <group>
                            <field name="mes" readonly="1" attrs="{'invisible': [('mes','=',False)]}"/>
                            <field name="year" readonly="1" attrs="{'invisible': [('year','=',0)]}"/>
                        </group>
                    </group>
            	</sheet>
                <footer>
                    <button name="generate_report" string="Aceptar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_report_ruta" model="ir.actions.act_window">
        <field name="name">Filtro de despachos</field>
        <field name="res_model">wizard.report.turno</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_report_ruta_view"/>
        <field name="target">new</field>
    </record>

    <menuitem name="Despachos por Barrios" id="menu_action_wizard_report_ruta" action="action_wizard_report_ruta" parent="informe_menu"/>

</odoo>