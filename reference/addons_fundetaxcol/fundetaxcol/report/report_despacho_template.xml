<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="report_despacho">
	    <!-- <t t-call="web.html_container"> -->
	    	<t t-foreach="docs" t-as="o">
	            <t t-call="web.internal_layout">
	                <div class="page">
	                    <table width="100%" class="text-center">
	                    	<tr>
								<td>Turno: <t t-esc="o.sequence" /></td>
							</tr>
							<tr>
								<td>Usuario: <t t-esc="o.create_uid.name" /></td>
							</tr>
							<tr>
								<td>Destino: <t t-esc="o.tarifa_id.name" /></td>
							</tr>
							<tr>
								<td>Tarifa sugerida: <t t-esc="o.valor" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" /></td>
							</tr>
							<tr>
								<td>Vehículo: <t t-esc="o.vehiculo_id.name" /></td>
							</tr>
							<tr>
								<td>Conductor: <t t-esc="o.conductor_id.name" /></td>
							</tr>
	                    </table>
	                    <br/>
						<table width="100%" class="text-center" style="font-style:italic;">
							<tr>
								<td><i>Fecha - Hora</i></td>
							</tr>
							<tr>
								<td><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')" /></td>
							</tr>
						</table>
	                    <br/>
						<table width="100%" class="text-center" style="font-style:italic;">
							<tr>
								<td>Tels: <t t-esc="o.company_id.phone" /></td>
							</tr>
							<tr>
								<td><t t-esc="o.company_id.email" /></td>
							</tr>
							<tr>
								<td><t t-esc="o.company_id.website" /></td>
							</tr>
							<tr>
								<td><t t-esc="o.company_id.report_footer" /></td>
							</tr>
						</table>
	                </div>
	            </t>
	        </t>
		<!-- </t> -->
	</template>
</odoo>