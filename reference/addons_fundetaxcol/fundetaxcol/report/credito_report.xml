<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <report
            id="menu_report_cr_ingreso"
            string="Estado de Cuentas"
            model="res.partner"
            report_type="qweb-pdf"
            name="fundetaxcol.report_cr_ingreso"
            menu="True"
        />

        <template id="report_cr_ingreso">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 class="text-center">Estado de Cuentas - <t t-esc="o.name" /></h2>
                            <t t-if="len(o.cr_ingreso_ids) != 0">
                                <h2 class="text-center">Crédito Ingreso</h2>
                                <table class="table">
                                    <thead>
                                        <th>Fecha</th>
                                        <th>Concepto</th>
                                        <th class="text-right">Valor</th>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_cr_ingreso" t-value="0" />
                                        <tr t-foreach="o.cr_ingreso_ids" t-as="ingreso">
                                            <t t-set="subtotal" t-value="ingreso.cantidad * ingreso.valor" />
                                            <t t-if="ingreso.tipo == 'cr_ingreso'">
                                                <t t-set="total_cr_ingreso" t-value="total_cr_ingreso + subtotal" />
                                            </t>
                                            <t t-else="">
                                                <t t-set="total_cr_ingreso" t-value="total_cr_ingreso - subtotal" />
                                            </t>

                                            <td><t t-esc="datetime.datetime.strptime(ingreso.create_date, '%Y-%m-%d %H:%M:%S')" /></td>
                                            <td><t t-esc="ingreso.name" /></td>
                                            <td class="text-right"><t t-esc="subtotal" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" /></td>
                                        </tr>
                                        <tr>
                                            <th>Total Saldo</th>
                                            <th class="text-right" colspan="2">
                                                <t t-esc="total_cr_ingreso" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" />
                                            </th>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-if="len(o.cr_prestamo_ids) != 0">
                                <h2 class="text-center">Crédito Préstamo</h2>
                                <table class="table">
                                    <thead>
                                        <th>Fecha</th>
                                        <th>Concepto</th>
                                        <th class="text-right">Valor</th>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_cr_prestamo" t-value="0" />
                                        <tr t-foreach="o.cr_prestamo_ids" t-as="prestamo">
                                            <t t-set="subtotal" t-value="prestamo.cantidad * prestamo.valor" />
                                            <t t-if="prestamo.tipo == 'cr_prestamo'">
                                                <t t-set="total_cr_prestamo" t-value="total_cr_prestamo + subtotal" />
                                            </t>
                                            <t t-else="">
                                                <t t-set="total_cr_prestamo" t-value="total_cr_prestamo - subtotal" />
                                            </t>

                                            <td><t t-esc="datetime.datetime.strptime(prestamo.create_date, '%Y-%m-%d %H:%M:%S')" /></td>
                                            <td><t t-esc="prestamo.name" /></td>
                                            <td class="text-right"><t t-esc="subtotal" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" /></td>
                                        </tr>
                                        <tr>
                                            <th>Total Saldo</th>
                                            <th class="text-right" colspan="2">
                                                <t t-esc="total_cr_prestamo" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" />
                                            </th>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>