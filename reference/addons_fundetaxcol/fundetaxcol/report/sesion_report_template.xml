                    <table class="table">
                        <tr>
                            <td width="20%"><strong>Total Pagos</strong></td>
                            <td width="10%" class="text-right"><t t-esc="o.cantidad_pago"/></td>
                            <td width="35%" class="text-right"><strong><t t-esc="o.total_pago" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></strong></td>
