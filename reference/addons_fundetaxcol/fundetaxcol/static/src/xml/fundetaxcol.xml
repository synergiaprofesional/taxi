	<t t-name="fundetaxcol.print.ticket">
		<t t-call="fundetaxcol.print.ticket.pago"/>
	</t>

	<t t-name="fundetaxcol.print.ahorro">
		<div class="no_print">
			<div class="receipt">
				<table style="width:100%">
					<tr>
						<td colspan="2" class="text-center">
							<h3 style="margin:0;"><t t-esc="widget.context.company.name"/></h3>
						</td>
						<td width="30%"/>
					</tr>
					<tr>
						<td colspan="2" class="text-center">
							<hr style="margin:0;"/>
						</td>
					</tr>
					<tr>
						<td class="text-center" colspan="2"><strong>RETIRO AHORROS</strong></td>
					</tr>
					<tr>
						<td class="text-center" colspan="2">Usuario: <t t-esc="widget.context.user" /></td>
					</tr>
					<tr>
						<td class="text-center" colspan="2">Conductor: <t t-esc="widget.context.conductor" /></td>
					</tr>
					<tr>
						<td class="text-center" colspan="2">Valor Retiro: $ <t t-esc="widget.context.valor" /></td>
					</tr>
					<tr t-if="widget.context.ahorro_ids.length != 0">
						<td colspan="2">
							<br/>
						</td>
					</tr>
					<!--tr>
						<td class="text-right" style="padding-left:16px;">Conductor: </td>
						<td style="padding-left:16px;"><t t-esc="widget.context.conductor"/></td>
					</tr>
					<tr>
						<td class="text-right" style="padding-left:16px;">Valor retiro: </td>
						<td style="padding-left:16px;">$ <t t-esc="widget.context.valor"/></td>
					</tr-->
					<tr t-if="widget.context.ahorro_ids.length != 0">
						<th width="35%" class="text-right" style="padding-left:16px;">Concepto</th>
						<th style="padding-left:16px;">Valor</th>
					</tr>
					<t t-foreach="widget.context.ahorro_ids" t-as="concepto">
						<tr>
							<td width="35%" class="text-right" style="padding-left:16px;">
								<t t-esc="concepto.concepto"/>
							</td>
							<td style="padding-left:16px;">
								$ <t t-esc="concepto.valor"/>
							</td>
						</tr>
					</t>
					<tr t-if="widget.context.ahorro_ids.length != 0">
						<td colspan="2">
							<br/>
						</td>
					</tr>
					<tr>
						<td class="text-center" colspan="2"><strong>Total ahorros: $ <t t-esc="widget.context.restante" /></strong></td>
					</tr>
					<!--tr>
						<td class="text-right" style="padding-left:16px;"><strong>Total Ahorros:</strong></td>
						<td style="padding-left:16px;"><strong>$ <t t-esc="widget.context.restante"/></strong></td>
					</tr-->
					<tr>
						<td colspan="2" class="text-center">
							<small><i>Fecha Hora</i></small>
						</td>
