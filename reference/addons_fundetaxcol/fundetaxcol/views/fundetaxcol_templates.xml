<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="fundetaxcol_assets_backend" name="Fundetaxcol Application Assets Backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="/fundetaxcol/static/src/css/fundetaxcol.css" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/__action_manager.js" />
        </xpath>
    </template>


    <template id="fundetaxcol_assets" name="Fundetaxcol Application Assets" inherit_id="web.assets_frontend" primary="True">
        <xpath expr="." position="inside">
            <!--link rel='stylesheet' href='/fundetaxcol/static/src/css/bootstrap.min.css'/-->
            <link rel="stylesheet" href="/fundetaxcol/static/src/css/fundetaxcol.css" />

            <script type="text/javascript" src="/fundetaxcol/static/src/js/main.js" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/models.js" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/turnos.js" />

            <script type="text/javascript" src="/fundetaxcol/static/src/js/__print_ticket.js" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/__print_ticket_client.js" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/__print_ticket_ahorro.js" />
            <script type="text/javascript" src="/fundetaxcol/static/src/js/z_tablero_turno.js" />

            <script type="text/javascript" src="/bus/static/src/js/bus.js" />
        </xpath>
    </template>

    <template id="index">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    ,
                    };
                </script>
            </t>
            <div t-att-data="data" class="o_fundetaxcol_app" />
        </t>
    </template>

    <template id="ticket">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    };
                </script>
            </t>
            <div t-att-data_pago="data" class="o_fundetaxcol_print_ticket" />
        </t>
    </template>

    <template id="ticket_client">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    };
                </script>
            </t>
            <div t-att-data_ticket_client="data" class="o_fundetaxcol_print_ticket_client" />
        </t>
    </template>

    <template id="ahorro">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    };
                </script>
            </t>
            <div t-att-data_ahorro="data" class="o_fundetaxcol_print_ahorro" />
        </t>
    </template>

    <template id="ticket_ahorro">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    };
                </script>
            </t>
            <div t-att-data_ticket_ahorro="data" class="o_fundetaxcol_print_ticket_ahorro" />
        </t>
    </template>

    <template id="tablero_turnos">
        <t t-call="web.layout">
            <t t-set="head">
                <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
                <meta http-equiv="content-type" content="text/html, charset=utf-8" />

                <meta name="viewport" content=" width=device-width, user-scalable=no" />
                <meta name="apple-mobile-web-app-capable" content="yes" />
                <meta name="mobile-web-app-capable" content="yes" />

                <t t-call-assets="web.assets_common" t-js="false" />
                <t t-call-assets="web.assets_common" t-css="false" />
                <t t-call-assets="fundetaxcol.fundetaxcol_assets" />

                <script type="text/javascript">
                    odoo.session_info = {
                        user_id:
                    <t t-esc="json.dumps(request.env.user.id)" />
                    ,
                        company_id:
                    <t t-esc="json.dumps(request.env.user.company_id.id)" />
                    };
                </script>
            </t>
            <div t-att-data_sesion_bahia_id="id" t-att-data-name="name" class="o_fundetaxcol_tablero_turnos" />
        </t>
    </template>

</odoo>