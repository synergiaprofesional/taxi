<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record model='ir.ui.view' id='secuencia_tree_view'>
      <field name='name'>secuencia.tree</field>
      <field name='model'>fundetaxcol.secuencia.ticket</field>
      <field name='arch' type='xml'>
        <tree>
          <field name='name'/>
          <field name='numero_str'/>
        </tree>
      </field>
    </record>

  	<record model="ir.ui.view" id="secuencia_form_view">
  		<field name="name">secuencia.form</field>
  		<field name="model">fundetaxcol.secuencia.ticket</field>
  		<field name="arch" type="xml">
  			<form string="Secuencia">
  				<sheet>
  					<group>
  						<group>
	  						<field name="name"/>
                <field name="prefijo"/>
	  						<field name="numero"/>
	  					</group>
	  					<group>
	  						<field name="numero_str" readonly="1"/>
	  						<field name="padding"/>
  						</group>
  					</group>
  				</sheet>
  			</form>
  		</field>
  	</record>

    <record id="secuencia_action" model="ir.actions.act_window">
      <field name="name">Secuencias</field>
      <field name="res_model">fundetaxcol.secuencia.ticket</field>
      <field name="view_type">form</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="secuencia_menu" name="Secuencias" parent="fundetaxcol.administracion_system_menu" action="secuencia_action"/>

  </data>
</odoo>