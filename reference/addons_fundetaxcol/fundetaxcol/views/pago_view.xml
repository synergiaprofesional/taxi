<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    	<record id="view_filter_pago" model="ir.ui.view">
            <field name="name">Pago Filtros</field>
            <field name="model">fundetaxcol.pago</field>
            <field name="arch" type="xml">
                <search>
                    <field name="vehiculo_id" />
                    <field name="conductor_id" />
                    <separator />
                    <filter name="group_sesion_bahia" string="Bahía" context="{'group_by':'bahia_id'}" />
                </search>
            </field>
        </record>

    	<record model="ir.ui.view" id="pago_concepto_view_kanban">
        	<field name="name">pago.concepto.view.kanban</field>
        	<field name="model">fundetaxcol.pago.concepto</field>
        	<field name="arch" type="xml">
        		<kanban class="o_kanban_dashboard">
		          <templates>
		            <t t-name="kanban-box">
		              <div class="oe_kanban_global_click">
						<a t-if="!read_only_mode" type="delete" class="fa fa-times pull-right" style="position:absolute;right:0;padding-right:8px;"/>
		              	<div class="o_primary">
		              		<strong><field name="concepto_id"/></strong>
		              		<strong style="float:right;">$ <field name="valor"/></strong>
		              	</div>
		              </div>
		            </t>
		          </templates>
		        </kanban>
		    </field>
		</record>

		<record model="ir.ui.view" id="pago_concepto_view_form">
			<field name="name">pago.concepto.view.form</field>
			<field name="model">fundetaxcol.pago.concepto</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<group>
							<group>
								<field name="tipo" invisible="1"/>
								<field name="concepto_id"/>
								<field name="cantidad"/>
							</group>
							<group>
								<field name="valor" attrs="{'readonly': [('tipo','=','valor_fijo')]}"/>
								<field name="subtotal" readonly="1" sum="SubTotal"/>
							</group>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record id="view_filter_pago" model="ir.ui.view">
		    <field name="name">Pago Filtros</field>
		    <field name="model">fundetaxcol.pago</field>
		    <field name="arch" type="xml">
		        <search>
		        	<field name="vehiculo_id" />
		            <field name="conductor_id" />
		        </search>
		    </field>
		</record>
        
        <record model="ir.ui.view" id="pago_taxi_tree">
        	<field name="name">pago_taxi.tree</field>
        	<field name="model">fundetaxcol.pago</field>
        	<field name="arch" type="xml">
        		<tree create="false" edit="false" delete="false">
        			<field name="fecha"/>
        			<field name="consecutivo"/>
        			<field name="vehiculo_id"/>
        			<field name="conductor_id"/>
        			<field name="valor" sum="Total"/>
        		</tree>
        	</field>
        </record>

        <record model="ir.ui.view" id="pago_taxi_form">
        	<field name="name">pago_taxi.form</field>
        	<field name="model">fundetaxcol.pago</field>
        	<field name="arch" type="xml">
        		<form delete="false">
        			<header>
        				<button name="print_pago" class="btn btn-primary" string="Imprimir" type="object" attrs="{'invisible': [('create_date','=',False)]}"/>
        				<!--button name="print" class="btn btn-danger" id="imprimir_pago" string="Imprimir" type="object" attrs="{'invisible': [('create_date','=',False)]}"/-->
        			</header>
        			<sheet>
        				<field name="create_date" invisible="1"/>
	        			<field name="concepto_tarifa_base_id" invisible="1"/>
	        			<field name="vehiculo_ids" invisible="1"/>
	        			<field name="conductor_ids" invisible="1"/>
	        			<field name="secuencia_ticket_id" invisible="1"/>
	        			<field name="bahia_id" invisible="1"/>
	        			<field name="valor" invisible="1"/>
						<field name="puede_editar" invisible="1"/>
        				<h3 class="oe_read_only">Consecutivo de Pago #<field name="consecutivo"/></h3>
        				<group>
        					<group>
	        					<field name="fecha" invisible="1"/>
	        					<field name="vehiculo_id" attrs="{'readonly':[('puede_editar','=',False)]}" domain="[('id','not in',vehiculo_ids)]" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
	        					<field name="temperatura" />
	        					<field name="nota" />
		        			</group>
		        			<group>
		        				<field name="conductor_id" attrs="{'readonly':[('puede_editar','=',False)]}" domain="[('id','in',conductor_ids)]" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
	        					<field name="limpieza" />
		        				<field name="enturnar" attrs="{'invisible': [('create_date','!=',False)]}"/>
		        			</group>
	        			</group>
	        			<notebook>
		        			<page string="Conceptos">
		        				<field name="concepto_ids" nolabel="1" >
		        					<tree editable="bottom">
		        						<field name="create_date" invisible="1"/>
		        						<field name="pago_id" invisible="1"/>
		        						<field name="tipo" invisible="1"/>
		        						<field name="concepto_id" attrs="{'readonly': [('create_date','!=',False)]}" options="{'no_create': True, 'no_create_edit': True}" />
		        						<field name="cantidad" />
		        						<field name="valor" attrs="{'readonly': [('tipo','=','valor_fijo')]}"/>
		        						<field name="subtotal" readonly="1" sum="SubTotal"/>
		        					</tree>
		        				</field>
		        			</page>
							<page string="Log" groups="base.group_system,fundetaxcol.group_administrador">
		        				<field name="concepto_log_ids" nolabel="1" readonly="1">
		        					<tree>
										<field name="create_uid" string="Usuario"/>
										<field name="create_date" string="Fecha"/>
										<field name="etiqueta"/>
		        						<field name="concepto_id"/>
		        						<field name="cantidad"/>
		        						<field name="valor"/>
		        						<field name="subtotal"/>
		        					</tree>
		        				</field>
		        			</page>
		        		</notebook>
        			</sheet>
        		</form>
        	</field>
        </record>

        <record id="action_pago_taxi" model="ir.actions.act_window">
        	<field name="name">Pago Vehículo</field>
        	<field name="res_model">fundetaxcol.pago</field>
        	<field name="view_type">form</field>
        	<field name="view_mode">tree,form</field>
        	<field name="help" type="html">
        		<p>
        			Aún no se han registrado pagos
        		</p>
        	</field>
        </record>

        <!--record id="action_print_ticket" model="ir.actions.server">
		    <field name="name">Imprimir Ticket</field>
		    <field name="type">ir.actions.server</field>
		    <field name="model_id" ref="model_fundetaxcol_pago"/>
		    <field name="state">code</field>
		    <field name="code">
		    	action = {
		    		"type": "ir.actions.act_url",
		    		"url": "/print/ticket?pago_id=%s" %(record.id),
		    		"target": "self",
		    	}
		    </field>
		</record-->

        <menuitem id="pago_taxi_menu" name="Pagos" parent="fundetaxcol.modulo_menu" action="action_pago_taxi"/>

        <!--Ingresos-->
        <record model="ir.ui.view" id="pago_taxi_tree_ingreso">
        	<field name="name">pago_taxi_ingreso.tree</field>
        	<field name="model">fundetaxcol.pago</field>
        	<field name="arch" type="xml">
        		<tree create="false" edit="false" delete="false">
        			<field name="fecha"/>
        			<field name="consecutivo"/>
        			<field name="vehiculo_id"/>
        			<field name="conductor_id"/>
        			<field name="valor" sum="Total"/>
        			<field name="sesion_en_progreso" invisible="1"/>
        		</tree>
        	</field>
        </record>
        <record id="action_pago_taxi_ingreso" model="ir.actions.act_window">
        	<field name="name">Ingresos</field>
        	<field name="res_model">fundetaxcol.pago</field>
        	<field name="view_type">form</field>
        	<field name="view_mode">tree</field>
        	<field name="view_ids" eval="[
		        (5, 0, 0),
		        (0, 0, {'view_mode': 'tree', 'view_id': ref('pago_taxi_tree_ingreso')}),
		        ]"
		    />
		    <field name="domain">[('sesion_en_progreso','=',True)]</field>
        	<field name="help" type="html">
        		<p>
        			Aún no se han registrado ingresos
        		</p>
        	</field>
        </record>
        <menuitem 
        	id="pago_taxi_menu_ingreso" 
        	name="Ingresos" 
        	parent="fundetaxcol.modulo_menu" 
        	action="action_pago_taxi_ingreso"
        	sequence="99"
        />
        <!--Ingresos-->

    </data>
</odoo>
