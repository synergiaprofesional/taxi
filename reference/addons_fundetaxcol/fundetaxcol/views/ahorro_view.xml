<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="pago_ahorro_tree">
        	<field name="name">pago_ahorro_tree_view</field>
        	<field name="model">fundetaxcol.ahorro</field>
        	<field name="arch" type="xml">
        		<tree create="false">
        			<field name="create_date" string="Fecha"/>
        			<field name="conductor_id"/>
        			<field name="valor" sum="Total"/>
        		</tree>
        	</field>
        </record>

        <record model="ir.ui.view" id="pago_ahorro_form">
        	<field name="name">pago_ahorro_form_view</field>
        	<field name="model">fundetaxcol.ahorro</field>
        	<field name="arch" type="xml">
        		<form create="false">
        			<header>
        				<button name="print_pago" class="btn btn-primary" string="Imprimir" type="object" attrs="{'invisible': [('create_date','=',False)]}"/>
        			</header>
        			<sheet>
	        			<field name="bahia_id" invisible="1" />
        				<group>
        					<group>
        						<field name="conductor_ids" widget="many2many_tags" invisible="1" />
	        					<field name="conductor_id" domain="[('id','not in',conductor_ids),('conductor','=',True),('is_company','=',False)]" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
	        					<field name="create_date" string="Fecha" attrs="{'invisible': [('create_date','=',False)]}" />
		        			</group>
	        			</group>
	        			<notebook>
		        			<page string="Conceptos">
		        				<field name="concepto_detalle_ids">
		        					<tree editable="bottom">
		        						<field name="ahorro_id" invisible="1"/>
		        						<field name="concepto_ids" widget="many2many_tags" invisible="1" />
		        						<field name="concepto_id" domain="[('id','in',concepto_ids)]" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
                                        <field name="acumulado" groups="fundetaxcol.group_administrador" />
		        						<field name="valor" sum="Total" />
		        					</tree>
		        				</field>
		        			</page>
		        		</notebook>
        			</sheet>
        		</form>
        	</field>
        </record>

        <record id="pago_ahorro_action" model="ir.actions.act_window">
        	<field name="name">Ahorros</field>
        	<field name="res_model">fundetaxcol.ahorro</field>
        	<field name="view_type">form</field>
        	<field name="view_mode">tree,form</field>
        	<field name="help" type="html">
        		<p>
        			Aún no se han registrado ahorros
        		</p>
        	</field>
        </record>

        <menuitem 
        	id="pago_ahorro_menu" 
        	name="Ahorros" 
        	parent="fundetaxcol.modulo_ahorro" 
        	action="pago_ahorro_action" 
        	sequence="1" 
        />

    </data>
</odoo>
